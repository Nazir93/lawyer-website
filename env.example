# =====================================================
# КОНФИГУРАЦИЯ САЙТА ЮРИСТА
# Скопируйте этот файл как .env.local и заполните значения
# =====================================================

# =====================================================
# БАЗА ДАННЫХ (PostgreSQL)
# =====================================================
# Для локальной разработки:
DATABASE_URL="postgresql://user:password@localhost:5432/lawyer_db"

# Для VPS (REG.RU и др.):
# DATABASE_URL="postgresql://lawyer_user:YOUR_PASSWORD@localhost:5432/lawyer_db"

# Для Yandex Cloud:
# DATABASE_URL="postgresql://user:password@rc1a-xxx.mdb.yandexcloud.net:6432/database?sslmode=require"

# =====================================================
# NEXTAUTH (Аутентификация)
# =====================================================
# Секретный ключ для шифрования сессий
# Сгенерируйте: openssl rand -base64 32
# Или: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="your-secret-key-here"

# URL вашего сайта
# Для разработки: http://localhost:3000
# Для продакшена: https://ваш-домен.ru
NEXTAUTH_URL="http://localhost:3000"

# =====================================================
# ХРАНИЛИЩЕ ФАЙЛОВ
# =====================================================
# Вариант 1: Локальное хранилище (рекомендуется для VPS)
UPLOAD_DIR="./public/uploads"

# Вариант 2: Yandex Object Storage (S3-совместимое)
# YANDEX_S3_ACCESS_KEY="your-access-key"
# YANDEX_S3_SECRET_KEY="your-secret-key"
# YANDEX_S3_BUCKET="lawyer-files"
# YANDEX_S3_ENDPOINT="https://storage.yandexcloud.net"

# =====================================================
# TELEGRAM (Уведомления о заявках)
# =====================================================
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN="your-bot-token"

# ID чата/группы для уведомлений
# Получите через @userinfobot или @getidsbot
TELEGRAM_CHAT_ID="your-chat-id"

# =====================================================
# YANDEX ID (OAuth авторизация - опционально)
# =====================================================
# Создайте приложение на https://oauth.yandex.ru/
# YANDEX_CLIENT_ID="your-yandex-client-id"
# YANDEX_CLIENT_SECRET="your-yandex-client-secret"
